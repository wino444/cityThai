DA.AddCommand("antimessage", "ป้องกันข้อความขึ้นมา(เช่นมีคนโอนเงินมา)", function()
    getgenv().AntiMessage_Enabled = not getgenv().AntiMessage_Enabled
    local enabled = getgenv().AntiMessage_Enabled

    local Players = game:GetService("Players")
    local plr = Players.LocalPlayer

    local function disableScript()
        pcall(function()
            local ls = plr.PlayerGui:FindFirstChild("Announcement", true) and 
                       plr.PlayerGui.Announcement:FindFirstChild("LocalScript")
            if ls and ls.ClassName == "LocalScript" then
                ls.Disabled = true
            end
        end)
    end

    local function enableScript()
        pcall(function()
            local ls = plr.PlayerGui:FindFirstChild("Announcement", true) and 
                       plr.PlayerGui.Announcement:FindFirstChild("LocalScript")
            if ls and ls.ClassName == "LocalScript" then
                ls.Disabled = false  -- เปิดให้ทำงานได้ปกติ
            end
        end)
    end

    -- ล้าง connection เก่า (ป้องกันซ้ำ)
    if getgenv().AntiMessage_Connections then
        for _, conn in pairs(getgenv().AntiMessage_Connections) do
            if conn.Connected then conn:Disconnect() end
        end
    end
    getgenv().AntiMessage_Connections = {}

    if enabled then
        -- เปิดโหมดปิดประกาศ
        disableScript()  -- ปิดตอนนี้เลย

        -- ดักเกิดใหม่ + ดักสร้างใหม่ → ปิดตลอด
        table.insert(getgenv().AntiMessage_Connections, plr.CharacterAdded:Connect(function()
            task.wait(0.5)
            disableScript()
        end))

        table.insert(getgenv().AntiMessage_Connections, plr.PlayerGui.ChildAdded:Connect(function(child)
            if child.Name == "Announcement" then
                table.insert(getgenv().AntiMessage_Connections, child.ChildAdded:Connect(function(grandchild)
                    if grandchild.Name == "LocalScript" then
                        task.wait()
                        grandchild.Disabled = true  -- ปิดอย่างเดียว ไม่ลบ!
                    end
                end))
                -- ถ้ามีอยู่แล้วใน Announcement ก็ปิดเลย
                local ls = child:FindFirstChild("LocalScript")
                if ls then ls.Disabled = true end
            end
        end))

        DA.Notify("🛑 ข้อความประกาศถูกปิดแล้ว (เงียบสงบ)", 3)
        print("🖤 ANTI-MESSAGE: เปิดใช้งาน – ประกาศถูกปิดถาวร")
    else
        -- ปิดโหมด → ปลดล็อกให้กลับมาแสดงได้
        enableScript()
        DA.Notify("🟢 ข้อความประกาศถูกเปิดแล้ว", 3)
        print("🔓 ANTI-MESSAGE: ปิดใช้งาน – ประกาศกลับมาแสดงปกติ")
    end
end, 2)
